# إعدادات الخادم — انسخ هذا الملف إلى .env.local واملأه.
# .env.local لا يُرفع إلى git ولا يُشارك: فيه كلمات المرور.

# ---------------------------------------------------------------- قاعدة البيانات
# على هوستنجر: تُنشأ القاعدة والمستخدم من hPanel ← Databases ← MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ------------------------------------------------------------------ لوحة التحكم
# مفتاح توقيع الجلسات. 32 حرفًا على الأقل، ويختلف عن مفتاح جهازك.
# ولّده بـ:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# تغييره يُخرج الجميع من اللوحة ويُبطل الجلسات القائمة.
AUTH_SECRET=

# ------------------------------------------------------------------ الصور المرفوعة
# مجلد دائم خارج مجلد الموقع، مثلًا /home/USER/5am-uploads
# خارج الموقع كي لا يُمحى عند رفع نسخة جديدة. على الخادم إلزامي: بدونه يُرفض الرفع.
# على جهازك يُترك فارغًا فتُحفظ في storage/uploads.
UPLOAD_DIR=

# صور الحضور والانصراف والوجوه — مجلد خاص لا يُنشر، خارج الموقع وخارج UPLOAD_DIR.
# فارغ = «<UPLOAD_DIR>-private».
PRIVATE_DIR=

# ------------------------------------------------------------------ المحادثة والبوت
# مفتاح OpenRouter (حساب مجاني على openrouter.ai ← Keys). بدونه البوت يرد من صفحات الموقع فقط.
OPENROUTER_API_KEY=
# مفتاح موديلنا على Hugging Face Space (نفس LLAMA_API_KEY هناك) — بعد التدريب على Colab.
OWN_MODEL_KEY=
# مفتاح DeepSeek (platform.deepseek.com) — اختياري؛ يُحط من اللوحة أسهل.
DEEPSEEK_API_KEY=
# عنوان الموقع الحقيقي (للروابط وخريطة الموقع).
SITE_URL=https://www.5a-eg.com

# ------------------------------------------------------------------ بريد الشركة (رمز دخول العملاء)
# من hPanel ← Emails: اعمل بريدًا مثل no-reply@5a-eg.com واكتب كلمته هنا.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=5A&M <no-reply@5a-eg.com>

# ------------------------------------------------------------------------ عام
NODE_ENV=production
PORT=3000
