# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# القالب يُشارَك: لا أسرار فيه، وبه يعرف من يرفع ما عليه ملؤه
!.env.example

# نسخ قاعدة البيانات ولقطات الفحص: محتوى حقيقي لا مكان له في المستودع
/scripts/dump.sql
/scripts/*-snapshot.json
/scripts/.nav-snap.json
/scripts/extracted*.json

# ملفات يرفعها أصحاب الموقع من لوحة التحكم
/public/assets/img/uploads/
/public/assets/video/uploads/
/storage/
/storage-private/
/uploads/
/private/
/backups/
/public/**/uploads/

# Database exports are transferred privately, never through GitHub.
*.sql
*.sql.gz
*.sql.zip
!/scripts/schema.sql

# Local tools, temporary diagnostics and runtime logs.
/.claude/
CLAUDE.md
AGENTS.md
/.tmp/
/tmp/
/cc-tmp.mjs
/test-results/
/playwright-report/
*.log
*.bak

# بيانات التدريب — تُصدَّر من القاعدة ولا تُشارَك على GitHub
/training-data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
